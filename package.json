{
  "name": "mirado",
  "version": "1.0.0",
  "description": "A minimalist Markdown viewer",
  "main": "src/main/main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/mirado.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/mirado/issues"
  },
  "homepage": "https://github.com/YOUR_USERNAME/mirado#readme",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "markdown",
    "viewer",
    "electron",
    "minimalist"
  ],
  "author": "Tran Minh Hieu",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-icon-builder": "^2.0.1"
  },
  "dependencies": {
    "marked": "^11.1.1",
    "marked-gfm-heading-id": "^3.1.3"
  },
  "build": {
    "appId": "com.mirado.app",
    "productName": "MiraDo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
